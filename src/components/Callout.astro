---
type Props = {
  type?: "info" | "warning" | "tip";
};

const { type = "info" } = Astro.props;

const styles: Record<string, { border: string; bg: string; icon: string }> = {
  info: { border: "#2563eb", bg: "#eff6ff", icon: "ℹ️" },
  warning: { border: "#d97706", bg: "#fffbeb", icon: "⚠️" },
  tip: { border: "#15803d", bg: "#f0fdf4", icon: "💡" },
};

const s = styles[type];
---

<div
  class="my-6 rounded-r-lg border-l-4 px-4 py-3 font-sans text-base not-italic"
  style={`border-color: ${s.border}; background: ${s.bg};`}
>
  <div class="flex items-start gap-2">
    <span class="mt-0.5 shrink-0 text-sm">{s.icon}</span>
    <div class="min-w-0 [&_p]:my-1.5 [&_strong]:font-semibold">
      <slot />
    </div>
  </div>
</div>
