---
type Props = {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: string;
  readTime?: string;
  source?: string;
  featured?: boolean;
};

const {
  href,
  title,
  description,
  date,
  tags,
  cover,
  readTime,
  source,
  featured = false,
} = Astro.props;

const formatted = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(date);
---

<a
  href={href}
  class="reveal group block no-underline"
>
  {
    featured && cover && (
      <div class="mb-5 overflow-hidden rounded-xl border border-[var(--border)]">
        <img
          src={cover}
          alt=""
          loading="lazy"
          class="aspect-[16/8] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      </div>
    )
  }
  <div class="flex items-start justify-between gap-6">
    <div class="min-w-0 flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[12.5px] text-[var(--ink-faint)]">
        {
          source && (
            <span class="font-semibold uppercase tracking-wide text-[var(--accent)]">
              {source}
            </span>
          )
        }
        {
          tags?.[0] && (
            <>
              {source && <span class="text-[var(--border)]">·</span>}
              <span class="uppercase tracking-wide">{tags[0]}</span>
            </>
          )
        }
        <time datetime={date.toISOString()}>{formatted}</time>
        {readTime && (
          <>
            <span class="text-[var(--border)]">·</span>
            <span>{readTime}</span>
          </>
        )}
      </div>
      <h2
        class:list={[
          "m-0 font-display font-semibold leading-[1.25] tracking-tight text-[var(--ink)] transition-colors group-hover:text-[var(--accent-hover)]",
          featured ? "text-2xl sm:text-[28px]" : "text-xl",
        ]}
      >
        {title}
      </h2>
      <p
        class:list={[
          "mb-0 mt-2 text-[15px] leading-relaxed text-[var(--ink-muted)]",
          featured ? "line-clamp-3" : "line-clamp-2",
        ]}
      >
        {description}
      </p>
    </div>
    {
      !featured && cover && (
        <div class="hidden w-[128px] shrink-0 overflow-hidden rounded-lg border border-[var(--border)] sm:block sm:w-[152px]">
          <img
            src={cover}
            alt=""
            loading="lazy"
            class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
          />
        </div>
      )
    }
  </div>
</a>
