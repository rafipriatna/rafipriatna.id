---
import Base from "@layouts/Base.astro";
import ArchivePage from "@components/ArchivePage.astro";
import { NOTES } from "@consts";
import { feedItems, PAGE_SIZE } from "@/lib/post";

export async function getStaticPaths() {
  const items = await feedItems("notes");
  const totalPages = Math.ceil(items.length / PAGE_SIZE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { items },
  }));
}

const { items } = Astro.props;
const currentPage = Number(Astro.params.page);
---

<Base title={`${NOTES.TITLE} — Halaman ${currentPage}`} description={NOTES.DESCRIPTION}>
  <ArchivePage
    collection="notes"
    eyebrow="Jurnal"
    title={NOTES.TITLE}
    description={NOTES.DESCRIPTION}
    items={items}
    currentPage={currentPage}
  />
</Base>
