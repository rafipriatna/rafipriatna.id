---
import Base from "@layouts/Base.astro";
import ArchivePage from "@components/ArchivePage.astro";
import { NOTES } from "@consts";
import { feedItems } from "@/lib/post";

const items = await feedItems("notes");
---

<Base title={NOTES.TITLE} description={NOTES.DESCRIPTION}>
  <ArchivePage
    collection="notes"
    eyebrow="Jurnal"
    title={NOTES.TITLE}
    description={NOTES.DESCRIPTION}
    items={items}
    currentPage={1}
  />
</Base>
