---
import { type CollectionEntry, getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import Article from "@components/Article.astro";
import { readingTime } from "@/lib/post";

export async function getStaticPaths() {
  const allWriteups = (await getCollection("writeups"))
    .filter((w) => !w.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return allWriteups.map((writeup) => ({
    params: { slug: writeup.slug },
    props: writeup,
  }));
}

type Props = CollectionEntry<"writeups">;

const writeup = Astro.props;
const { Content } = await writeup.render();
---

<Base title={writeup.data.title} description={writeup.data.description}>
  <Article
    title={writeup.data.title}
    description={writeup.data.description}
    date={writeup.data.date}
    readTime={readingTime(writeup.body)}
    backHref="/writeups"
    backLabel="Writeups"
  >
    <Content />
  </Article>
</Base>
