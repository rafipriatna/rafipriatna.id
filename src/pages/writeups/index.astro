---
import Base from "@layouts/Base.astro";
import ArchivePage from "@components/ArchivePage.astro";
import { WRITEUPS } from "@consts";
import { feedItems } from "@/lib/post";

const items = await feedItems("writeups");
---

<Base title={WRITEUPS.TITLE} description={WRITEUPS.DESCRIPTION}>
  <ArchivePage
    collection="writeups"
    eyebrow="Kasus"
    title={WRITEUPS.TITLE}
    description={WRITEUPS.DESCRIPTION}
    items={items}
    currentPage={1}
  />
</Base>
