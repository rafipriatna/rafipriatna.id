---
import Base from "@layouts/Base.astro";
---

<Base title="404" description="Halaman tidak ditemukan">
  <div class="py-24 text-center">
    <p class="m-0 text-4xl text-[var(--accent)]">✳</p>
    <h1 class="m-0 mt-4 font-display text-6xl font-bold tracking-tight">404</h1>
    <p class="mx-auto mt-3 max-w-sm font-serif text-lg italic text-[var(--ink-muted)]">
      Halaman ini tidak pernah ditulis — atau sudah saya hapus dari jurnal.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-[var(--ink)] px-6 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:bg-[var(--accent)]"
    >
      &larr; Kembali ke beranda
    </a>
  </div>
</Base>
