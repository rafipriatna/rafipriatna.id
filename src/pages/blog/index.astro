---
import Base from "@layouts/Base.astro";
import ArchivePage from "@components/ArchivePage.astro";
import { BLOG } from "@consts";
import { feedItems } from "@/lib/post";

const items = await feedItems("blog");
---

<Base title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <ArchivePage
    collection="blog"
    eyebrow="Arsip"
    title={BLOG.TITLE}
    description={BLOG.DESCRIPTION}
    items={items}
    currentPage={1}
    showTagPills
  />
</Base>
